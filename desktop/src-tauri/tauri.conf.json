{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stream Control Center",
  "version": "2.9.1",
  "identifier": "local.ilya.stream-control-center",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Stream Control Center",
        "width": 1180,
        "height": 780,
        "minWidth": 820,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://*:1985 http://*:8080 ws://127.0.0.1:4455 ws://localhost:4455; img-src 'self' data: blob:; media-src 'self' http://*:8080 blob:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline';"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ]
  }
}
